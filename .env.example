# ─────────────────────────────────────────────────────────────
# TORA — Variables de entorno
# Copia este archivo a .env.local y llena los valores reales.
# NUNCA commitear .env.local (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Supabase (obligatorias) ──────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_ID=

# ── App (opcionales) ─────────────────────────────────────────
# URL pública de la app (en Vercel se llena con el dominio final; vacío en dev)
# NEXT_PUBLIC_APP_URL=

# Timezone del negocio (default America/Mexico_City)
# NEXT_PUBLIC_TZ=America/Mexico_City

# ── Solo desarrollo local (NUNCA en Vercel) ──────────────────
# Access token de la Management API de Supabase, para `pnpm db:migrate`.
# Dashboard → Account → Access Tokens. Scope de cuenta completa: no exponer.
# SUPABASE_ACCESS_TOKEN=
